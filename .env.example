# ── Modo local ───────────────────────────────────────────────────────────────
# Quando true, o bot usa variáveis abaixo em vez de buscar na AWS
LOCAL_MODE=true

# ── WhatsApp / Meta ──────────────────────────────────────────────────────────
META_TOKEN=seu_token_aqui
PHONE_NUMBER_ID=seu_phone_number_id_aqui

# ── Google Service Account ───────────────────────────────────────────────────
TYPE=service_account
PROJECT_ID=seu_projeto_aqui
PRIVATE_KEY_ID=sua_chave_id_aqui
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
CLIENT_EMAIL=sua_conta@seu_projeto.iam.gserviceaccount.com
CLIENT_ID=000000000000000000000
AUTH_URI=https://accounts.google.com/o/oauth2/auth
TOKEN_URI=https://oauth2.googleapis.com/token
AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/sua_conta%40seu_projeto.iam.gserviceaccount.com

# ── Google Sheets ────────────────────────────────────────────────────────────
SPREADSHEET_ID=1Gb1I3lt4k6NQKJX3Og3YjgHBCskX0N_yK06CAxqaAnc

# ── Configuração geral ───────────────────────────────────────────────────────
OWNER_PHONE=5511974654256
REGION_NAME=sa-east-1
SECRET_NAME=bot-service-sm
